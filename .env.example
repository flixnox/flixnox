# Copy these into Render -> Environment. NEVER commit a real .env file.
# BOT_TOKEN comes from @BotFather
BOT_TOKEN=
BOT_USERNAME=SonicNoxBot
# short name you give in BotFather /newapp
MINIAPP_SHORT=room
# your Cloudflare Worker URL, https, no trailing slash
PUBLIC_URL=https://your-worker.workers.dev
# 32+ random characters, same value in the Worker
PROXY_SECRET=
# 32+ random characters, used only here
WEBHOOK_SECRET=
# your Telegram user id (comma separated for more owners)
OWNER_IDS=
# MongoDB Atlas free tier connection string
MONGO_URI=
# Optional
SUPPORT_URL=
API_BASE=https://curiousapis.name.ng
SC_SEARCH_PATH=/soundcloud/search
MAX_QUEUE=500
CURIOUS_API_KEY=
