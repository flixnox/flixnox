# Copy these into Render -> Environment. NEVER commit a real .env file.
# BOT_TOKEN comes from @BotFather
BOT_TOKEN=
BOT_USERNAME=SonicNoxBot
# short name you give in BotFather /newapp
MINIAPP_SHORT=room
# your Cloudflare Worker URL, https, no trailing slash
PUBLIC_URL=https://your-worker.workers.dev
# 32+ random characters, same value in the Worker
PROXY_SECRET=
# 32+ random characters, used only here
WEBHOOK_SECRET=
# your Telegram user id (comma separated for more owners)
OWNER_IDS=
# MongoDB Atlas free tier connection string
MONGO_URI=
# Optional
SUPPORT_URL=
# Music API (already built in as the default, only set these to override)
# JIOSAAVN_BASE=https://jiosaavn-api-ruddy-phi.vercel.app/api
# AUDIO_KBPS=160
MAX_QUEUE=500

# Optional: TURN/STUN servers for voice (JSON). Leave empty for free Google STUN.
ICE_SERVERS=

# Optional: YouTube fallback (used when JioSaavn has nothing / fails). 1 = on, 0 = off
YOUTUBE_ENABLED=1
# Optional: YouTube cookies.txt (Netscape format) as ONE base64 line. Helps when YouTube blocks the server IP.
# Create it with:  base64 -w0 cookies.txt     NEVER commit cookies or put them in the repo.
COOKIES_B64=
# Optional: proxy for YouTube lookups and the stream proxy, e.g. http://user:pass@host:port
YOUTUBE_PROXY=
# Optional: Shruti API (second source). Leave empty to disable.
SHRUTI_API_URL=https://api.shrutibots.in
SHRUTI_API_KEY=

